# Copy this file to .env.local for development.
# In Vercel, set these in Project Settings → Environment Variables.

# Required: Supabase project URL and anon key.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Optional: public origin used to build email redirect URLs.
# In production this should be your Vercel domain (no trailing slash).
REACT_APP_PUBLIC_APP_URL=https://your-domain.vercel.app
